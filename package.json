{
  "name": "@sabha-co/openclaw-sabha",
  "version": "2026.11.1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabha-co/openclaw-sabha.git"
  },
  "files": [
    "dist/",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "runtimeSetupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "sabha",
      "label": "Sabha",
      "selectionLabel": "Sabha (Bot API)",
      "detailLabel": "Sabha Bot",
      "docsPath": "/channels/sabha",
      "docsLabel": "sabha",
      "systemImage": "bubble.left.and.bubble.right",
      "blurb": "Connect OpenClaw to a Sabha chat server.",
      "markdownCapable": true,
      "setup": {
        "fields": [
          {
            "kind": "string",
            "cli": {
              "flags": "--base-url <url>",
              "description": "Sabha server URL including workspace prefix"
            },
            "key": "baseUrl"
          },
          {
            "kind": "string",
            "cli": {
              "flags": "--api-base-url <url>",
              "description": "Sabha bot API URL"
            },
            "key": "apiBaseUrl"
          },
          {
            "kind": "string",
            "sensitive": true,
            "cli": {
              "flags": "--bot-key <key>",
              "description": "Sabha bot key"
            },
            "key": "botKey"
          },
          {
            "kind": "string",
            "cli": {
              "flags": "--bot-name <name>",
              "description": "Bot display name"
            },
            "key": "botName"
          },
          {
            "kind": "string",
            "cli": {
              "flags": "--websocket-url <url>",
              "description": "Sabha cable URL"
            },
            "key": "websocketUrl"
          },
          {
            "kind": "choice",
            "choices": [
              "open",
              "allowlist"
            ],
            "cli": {
              "flags": "--dm-policy <policy>",
              "description": "DM admission policy"
            },
            "key": "dmPolicy"
          },
          {
            "kind": "string-list",
            "cli": {
              "flags": "--allow-from <ids>",
              "description": "Allowed Sabha user IDs"
            },
            "key": "allowFrom"
          }
        ]
      }
    },
    "install": {
      "npmSpec": "@sabha-co/openclaw-sabha",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.11.1"
    },
    "compat": {
      "pluginApi": ">=2026.11.1"
    },
    "build": {
      "openclawVersion": "2026.11.1"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "manifest:generate": "npm run build && node scripts/generate-manifest.mjs",
    "manifest:check": "node scripts/generate-manifest.mjs --check",
    "prepack": "npm run manifest:generate",
    "test:pack": "bash scripts/verify-pack.sh"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "typebox": "1.3.35",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "openclaw": "2026.11.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.58.1",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  }
}
