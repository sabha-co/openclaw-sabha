{
  "name": "@sabha-co/openclaw-sabha",
  "version": "0.8.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sabha-co/openclaw-sabha.git"
  },
  "files": [
    "index.ts",
    "setup-entry.ts",
    "src/",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "sabha",
      "label": "Sabha",
      "blurb": "Connect OpenClaw to a Sabha chat server.",
      "markdownCapable": true
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "openclaw": "^2026.4.0",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.58.1",
    "vitest": "^3.0.0"
  }
}
