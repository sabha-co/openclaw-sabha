{
  "id": "sabha",
  "channels": [
    "sabha"
  ],
  "name": "Sabha",
  "description": "Connect OpenClaw to a Sabha workspace as an app",
  "version": "2026.11.1",
  "contracts": {
    "tools": [
      "sabha_search_members",
      "sabha_create_dm"
    ]
  },
  "toolMetadata": {
    "sabha_search_members": {
      "replaySafe": true
    },
    "sabha_create_dm": {
      "sideEffecting": true
    }
  },
  "cliCommands": [
    {
      "name": "sabha",
      "description": "Sabha channel commands",
      "hasSubcommands": true
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "sabha": {
      "label": "Sabha",
      "description": "Connect to a Sabha workspace with an app key over the AppEvents WebSocket.",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          },
          "dmPolicy": {
            "type": "string",
            "enum": [
              "open",
              "allowlist"
            ]
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowPrivateNetwork": {
            "type": "boolean"
          },
          "replyToMode": {
            "type": "string",
            "enum": [
              "off",
              "first",
              "all"
            ]
          },
          "livePreview": {
            "type": "boolean"
          },
          "rooms": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "systemPrompt": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "accounts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "url": {
                  "type": "string"
                },
                "dmPolicy": {
                  "type": "string",
                  "enum": [
                    "open",
                    "allowlist"
                  ]
                },
                "allowFrom": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "allowPrivateNetwork": {
                  "type": "boolean"
                },
                "replyToMode": {
                  "type": "string",
                  "enum": [
                    "off",
                    "first",
                    "all"
                  ]
                },
                "livePreview": {
                  "type": "boolean"
                },
                "rooms": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "systemPrompt": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "name": {
                  "type": "string"
                },
                "appKey": {
                  "type": "string"
                },
                "cableUrl": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "defaultAccount": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "uiHints": {
        "enabled": {
          "label": "Enabled"
        },
        "url": {
          "label": "Workspace URL",
          "placeholder": "https://sabha.co/1000006",
          "help": "The Sabha workspace address, including the workspace number on sabha.co"
        },
        "accounts.*.appKey": {
          "label": "App key",
          "placeholder": "sabha_app_…",
          "sensitive": true,
          "help": "Shown once when an admin creates the app in Settings → Apps"
        },
        "accounts.*.cableUrl": {
          "label": "WebSocket URL",
          "placeholder": "wss://sabha.co/cable",
          "advanced": true,
          "help": "Only for servers whose WebSocket is not at /cable on the workspace host"
        },
        "dmPolicy": {
          "label": "DM policy",
          "help": "\"open\" answers anyone; \"allowlist\" answers only allowFrom"
        },
        "allowFrom": {
          "label": "Allowed users",
          "advanced": true,
          "help": "Sabha user ids admitted in allowlist mode"
        },
        "allowPrivateNetwork": {
          "label": "Allow private-network attachments",
          "advanced": true,
          "help": "Dangerous: lets attachment downloads reach private addresses. Only for split-horizon DNS installs."
        },
        "replyToMode": {
          "label": "Reply threading",
          "help": "\"off\" replies inline, \"first\" threads the first reply, \"all\" threads every reply"
        },
        "livePreview": {
          "label": "Live drafts",
          "advanced": true,
          "help": "Stream replies into a live draft while the agent writes. On by default; a Sabha server without live drafts posts the reply as usual"
        }
      }
    }
  }
}
