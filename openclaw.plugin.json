{
  "id": "sabha",
  "kind": "channel",
  "channels": ["sabha"],
  "name": "Sabha",
  "description": "Connect OpenClaw to a Sabha chat server",
  "configSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {}
  },
  "channelConfigs": {
    "sabha": {
      "label": "Sabha",
      "description": "Connect to a Sabha chat server via WebSocket or webhook.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable or disable the Sabha channel."
          },
          "baseUrl": {
            "type": "string",
            "description": "Sabha server URL (site root) including workspace ID for multi-tenant (e.g. https://sabha.co/1000006). The setup wizard hits {baseUrl}/skill to verify the URL points at a Sabha server."
          },
          "apiBaseUrl": {
            "type": "string",
            "description": "Bot API base URL (e.g. https://sabha.co/1000006/api/bots). Auto-populated from the registration response; bearer-auth HTTP calls go here."
          },
          "botKey": {
            "type": "string",
            "description": "Bot key from registration via join code (e.g. 42-AbCdEfGhIjKl)."
          },
          "webhookSecret": {
            "type": "string",
            "description": "Per-bot HMAC secret returned at registration. Reserved for webhook signature verification in a future release."
          },
          "botName": {
            "type": "string",
            "description": "Bot display name shown to users in typing indicators."
          },
          "connectionMode": {
            "type": "string",
            "enum": ["websocket", "webhook"],
            "default": "websocket",
            "description": "How to receive events. WebSocket (recommended) connects outbound; webhook requires inbound reachability."
          },
          "websocketUrl": {
            "type": "string",
            "description": "WebSocket URL (auto-detected from registration). Override only if needed."
          },
          "webhookPort": {
            "type": "number",
            "default": 8787,
            "description": "Webhook listener port (webhook mode only)."
          },
          "typingEnabled": {
            "type": "boolean",
            "default": true,
            "description": "Show 'Bot is typing...' while processing (WebSocket mode only)."
          },
          "dmPolicy": {
            "type": "string",
            "enum": ["open", "allowlist"],
            "default": "open",
            "description": "Who can send direct messages to the bot."
          },
          "allowFrom": {
            "type": "array",
            "items": { "type": "string" },
            "description": "User IDs allowed to DM (allowlist mode only)."
          },
          "allowPrivateAttachmentHosts": {
            "type": "boolean",
            "description": "Dangerous — disables SSRF protection on attachment downloads. Only enable in corporate / split-horizon DNS setups."
          },
          "replyToMode": {
            "type": "string",
            "enum": ["off", "first", "all"],
            "default": "first",
            "description": "Threading mode. 'off' = inline replies; 'first' = thread on first reply; 'all' = always thread."
          },
          "rooms": {
            "type": "object",
            "description": "Per-room overrides keyed by room id. Used for per-room system prompts.",
            "propertyNames": { "type": "string" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "systemPrompt": { "type": "string" }
              }
            }
          },
          "botAccounts": {
            "type": "object",
            "description": "Named bot accounts layered over the base config for multi-bot setups.",
            "propertyNames": { "type": "string" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "baseUrl": { "type": "string" },
                "apiBaseUrl": { "type": "string" },
                "botKey": { "type": "string" },
                "webhookSecret": { "type": "string" },
                "botName": { "type": "string" },
                "connectionMode": {
                  "type": "string",
                  "enum": ["websocket", "webhook"]
                },
                "websocketUrl": { "type": "string" },
                "webhookPort": { "type": "number" },
                "typingEnabled": { "type": "boolean" },
                "dmPolicy": {
                  "type": "string",
                  "enum": ["open", "allowlist"]
                },
                "allowFrom": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "allowPrivateAttachmentHosts": { "type": "boolean" },
                "replyToMode": {
                  "type": "string",
                  "enum": ["off", "first", "all"]
                }
              }
            }
          },
          "defaultBotAccount": {
            "type": "string",
            "description": "Bot account id used when no explicit account is passed. Defaults to the alphabetic-first entry."
          }
        }
      },
      "uiHints": {
        "baseUrl": {
          "label": "Server URL",
          "placeholder": "https://sabha.co/1000006"
        },
        "apiBaseUrl": {
          "label": "Bot API base URL",
          "placeholder": "https://sabha.co/1000006/api/bots",
          "advanced": true
        },
        "botKey": {
          "label": "Bot key",
          "placeholder": "42-AbCdEfGhIjKl",
          "sensitive": true
        },
        "webhookSecret": {
          "label": "Webhook secret",
          "placeholder": "whsec_…",
          "sensitive": true,
          "advanced": true
        },
        "connectionMode": {
          "label": "Connection mode"
        },
        "websocketUrl": {
          "label": "WebSocket URL",
          "advanced": true
        },
        "webhookPort": {
          "label": "Webhook port",
          "advanced": true
        },
        "dmPolicy": {
          "label": "DM policy"
        },
        "allowFrom": {
          "label": "Allow list",
          "advanced": true
        },
        "replyToMode": {
          "label": "Reply threading mode",
          "advanced": true
        }
      }
    }
  }
}
