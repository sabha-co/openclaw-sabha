{
  "name": "@sabha-co/openclaw-sabha",
  "version": "2026.4.30",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabha-co/openclaw-sabha.git"
  },
  "files": [
    "index.ts",
    "setup-entry.ts",
    "src/",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "sabha",
      "label": "Sabha",
      "selectionLabel": "Sabha (Bot API)",
      "detailLabel": "Sabha Bot",
      "docsPath": "/channels/sabha",
      "docsLabel": "sabha",
      "systemImage": "bubble.left.and.bubble.right",
      "blurb": "Connect OpenClaw to a Sabha chat server.",
      "markdownCapable": true
    },
    "install": {
      "npmSpec": "@sabha-co/openclaw-sabha",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.9"
    },
    "compat": {
      "pluginApi": ">=2026.4.9"
    },
    "build": {
      "openclawVersion": "2026.4.9"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "openclaw": "2026.4.9",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.58.1",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.9"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  }
}
